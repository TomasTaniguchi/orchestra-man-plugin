// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doctor > explains a missing configuration (snapshot) 1`] = `
"# orchestra-man · diagnóstico

✗ Configuración: orchestra-man is not configured correctly (maskSalt: Invalid input). (archivo: /home/me/.config/orchestra-man/config.json)

## Estado
- ✗ Configuración: Corré /orchestra-man:configure (o \`npm run worker:setup\` en el repo del plugin para desplegar tu Worker)."
`;

exports[`doctor > explains an unreachable backend and keeps the local memory facts 1`] = `
"# orchestra-man · diagnóstico

✓ Configuración: modo d1 · https://w.dev
✗ Backend: cannot reach https://w.dev: fetch failed
✓ Agente: acme/api#laptop (local) · se registra al abrir la sesión o con orchestra_sync
✓ Memoria de este repo: 1 compartida, 1 personal, 1 fijada, 1 sesión · 2 cambios sin publicar (se publican en la próxima sincronización, o ya con orchestra_sync) · último cambio 2026-10-31T12:00:00.000Z

## Estado
- ✗ Backend: Revisá la URL con \`curl <workerUrl>/v1/health\` y tu conexión. La memoria local sigue funcionando y se publica cuando vuelva."
`;

exports[`doctor > reports a healthy setup (snapshot) 1`] = `
"# orchestra-man · diagnóstico

✓ Configuración: modo local · :memory:
✓ Backend: responde (versión 0.2.0)
✓ Agente: acme/api#laptop (local) · registrado
