// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doctor > explains a missing configuration (snapshot) 1`] = `
"# orchestra-man · diagnosis

✗ Configuration: orchestra-man is not configured correctly (maskSalt: Invalid input). (file: /home/me/.config/orchestra-man/config.json)

## Status
- ✗ Configuration: Run /orchestra-man:configure (or \`npm run worker:setup\` in the plugin repo to deploy your Worker)."
`;

exports[`doctor > explains an unreachable backend and keeps the local memory facts 1`] = `
"# orchestra-man · diagnosis

✓ Configuration: d1 mode · https://w.dev
✗ Backend: cannot reach https://w.dev: fetch failed
✓ Agent: acme/api#laptop (local) · registers when the session opens or with orchestra_sync
✓ This repo's memory: 1 shared, 1 personal, 1 pinned, 1 session · 2 unsynced changes (published on the next sync, or now with orchestra_sync) · last change 2026-10-31T12:00:00.000Z

## Status
- ✗ Backend: Check the URL with \`curl <workerUrl>/v1/health\` and your connection. Local memory keeps working and is published when it is back."
`;

exports[`doctor > reports a healthy setup (snapshot) 1`] = `
"# orchestra-man · diagnosis

✓ Configuration: local mode · :memory:
✓ Backend: responding (version 0.2.0)
✓ Agent: acme/api#laptop (local) · registered
✓ This repo's memory: 1 shared, 1 personal, 1 pinned, 1 session · 2 unsynced changes (published on the next sync, or now with orchestra_sync) · last change 2026-10-31T12:00:00.000Z

## Other repositories
- acme/billing: online · cs-billing (codespace) · last checkpoint 2026-10-31T12:00:00.000Z on main@abcdef1

## Inbox: 1 unread (see them with orchestra_inbox)

## Status
All good."
`;
